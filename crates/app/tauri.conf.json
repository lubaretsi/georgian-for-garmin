{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Georgian for Garmin",
  "identifier": "io.github.lubaretsi.georgian-for-garmin",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Georgian for Garmin",
        "width": 420,
        "height": 680,
        "resizable": false,
        "maximizable": false,
        "fullscreen": false,
        "center": true,
        "visible": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "category": "Utility",
    "shortDescription": "Georgian notifications on Garmin watches",
    "publisher": "George Lubaretsi",
    "copyright": "MIT License",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "linux": {
      "deb": {
        "files": {
          "/usr/lib/udev/rules.d/70-georgian-for-garmin.rules": "../../packaging/linux/70-georgian-for-garmin.rules"
        },
        "postInstallScript": "../../packaging/linux/deb-postinst.sh",
        "postRemoveScript": "../../packaging/linux/deb-postrm.sh"
      }
    },
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    }
  }
}
